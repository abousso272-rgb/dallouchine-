# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# GENIUSPAY PAYMENT CONFIGURATION (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ==============================================================================
# Public API Key: pk_sandbox_... or pk_live_...
GENIUSPAY_API_KEY="pk_sandbox_sample_key_sinosenegal"

# Secret API Key: sk_sandbox_... or sk_live_...
GENIUSPAY_API_SECRET="sk_sandbox_sample_secret_sinosenegal"

# Webhook secret used to verify HMAC-SHA256 signatures (whsec_...)
GENIUSPAY_WEBHOOK_SECRET="whsec_sample_geniuspay_secret_sinosenegal"

# Base URL for GeniusPay API: http://geniuspay.ci/api/v1/merchant
GENIUSPAY_BASE_URL="http://geniuspay.ci/api/v1/merchant"

# Environment: 'sandbox' for testing, 'production' for live payments
GENIUSPAY_ENVIRONMENT="sandbox"

# ==============================================================================
# SUPABASE CONFIGURATION (POSTGRES DATABASE & RLS)
# ==============================================================================
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
