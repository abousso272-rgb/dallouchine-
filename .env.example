# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# GENIUSPAY PAYMENT CONFIGURATION (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ==============================================================================
# API Key obtained from GeniusPay merchant dashboard
GENIUSPAY_API_KEY="gp_live_xxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook secret used to verify HMAC-SHA256 signatures
GENIUSPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Base URL for GeniusPay API (e.g., https://pay.genius.ci/api/v1)
GENIUSPAY_BASE_URL="https://pay.genius.ci/api/v1"

# Environment: 'sandbox' for testing, 'production' for live payments
GENIUSPAY_ENVIRONMENT="sandbox"

# ==============================================================================
# SUPABASE CONFIGURATION (POSTGRES DATABASE & RLS)
# ==============================================================================
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
