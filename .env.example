# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION (POSTGRES DATABASE & RLS)
# ==============================================================================
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==============================================================================
# ANALYSE DE PRODUIT PAR IA (photo / lien Alibaba) — SERVER-SIDE ONLY
# ==============================================================================
# Clé API Anthropic (console.anthropic.com). Sans elle, l'analyse affiche
# « pas encore activée » et le formulaire de sourcing reste utilisable.
ANTHROPIC_API_KEY=""
# Optionnel : modèle utilisé (défaut claude-sonnet-5-5)
# ANTHROPIC_MODEL="claude-sonnet-5-5"

# ==============================================================================
# PAIEMENTS — SasPay (fournisseur principal) — SERVER-SIDE ONLY
# ==============================================================================
# Clé secrète (app.saspay.me > Développeur) : sk_test_… pour tester, sk_live_… en production
SASPAY_SECRET_KEY=""
# Secret de signature affiché UNE SEULE FOIS à la création du webhook (URL : <APP_URL>/api/webhooks/saspay)
SASPAY_WEBHOOK_SECRET=""
# Frais : DEDUCTED = prélevés sur votre encaissement (le client paie le prix affiché) ; ADD_ON = ajoutés au client
SASPAY_FEE_MODE="DEDUCTED"
# Relais HTTP(S) à IP fixe pour les remboursements automatiques (SasPay exige une IP en liste blanche).
# Ex. URL fournie par Fixie / QuotaGuard Static, ou laisser vide si Vercel Static IPs est activé.
SASPAY_PROXY_URL=""
